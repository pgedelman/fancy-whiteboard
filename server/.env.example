# Port the server listens on
PORT=4000

# Allowed origin for CORS / socket.io (e.g. http://localhost:5173)
# Leave unset to allow any origin (fine for local dev)
CLIENT_ORIGIN=http://localhost:5173

# Optional: MongoDB connection string for persistent stroke storage.
# If unset, the server falls back to an in-memory store (data is lost on restart).
MONGO_URI=
